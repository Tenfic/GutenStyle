{
  "name": "gutenstyle",
  "version": "0.1.0",
  "description": "Visual styling system for native Gutenberg blocks.",
  "author": "Tenfic",
  "license": "GPL-2.0-or-later",
  "keywords": [
    "wordpress",
    "gutenberg",
    "block styles",
    "design system"
  ],
  "homepage": "https://gutenstyle.com/",
  "repository": {
    "type": "git",
    "url": "https://github.com/tenfic/gutenstyle.git"
  },
  "bugs": {
    "url": "https://github.com/tenfic/gutenstyle/issues"
  },
  "private": true,
  "engines": {
    "node": ">=24.18.0 <25",
    "npm": ">=11.16.0 <12"
  },
  "packageManager": "npm@11.16.0",
  "dependencies": {
    "antd": "5.29.3"
  },
  "devDependencies": {
    "@php-wasm/node": "3.1.56",
    "@php-wasm/universal": "3.1.56",
    "@tailwindcss/postcss": "4.3.3",
    "@types/react": "18.3.27",
    "@types/react-dom": "18.3.1",
    "@wordpress/api-fetch": "7.56.0",
    "@wordpress/block-editor": "18.0.0",
    "@wordpress/blocks": "16.1.0",
    "@wordpress/components": "41.0.0",
    "@wordpress/compose": "8.9.0",
    "@wordpress/data": "10.56.0",
    "@wordpress/editor": "15.1.0",
    "@wordpress/element": "8.8.0",
    "@wordpress/env": "11.16.0",
    "@wordpress/hooks": "4.56.0",
    "@wordpress/i18n": "6.29.0",
    "@wordpress/plugins": "7.56.0",
    "@wordpress/scripts": "36.0.0",
    "@wp-playground/cli": "3.1.56",
    "jest": "30.5.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3"
  },
  "scripts": {
    "check:engines": "wp-scripts check-engines",
    "start": "wp-scripts start --webpack-src-dir=src",
    "build": "wp-scripts build --webpack-src-dir=src",
    "typecheck": "tsc --noEmit",
    "lint": "npm run lint:js && npm run lint:css && npm run lint:php && npm run typecheck",
    "lint:js": "wp-scripts lint-js src",
    "lint:css": "wp-scripts lint-style src/**/*.css",
    "lint:php": "node scripts/lint-php.mjs",
    "format": "wp-scripts format",
    "test:unit": "npm run test:php",
    "test:php": "node scripts/run-php-tests.mjs",
    "env:start": "wp-env start",
    "env:stop": "wp-env stop",
    "env:playground:start": "wp-playground-cli start --path=. --wp=https://wordpress.org/wordpress-7.1.2.zip --php=8.3 --port=8888 --site-url=http://localhost:8888 --skip-browser --no-login --blueprint=playground/blueprint.json",
    "env:playground:reset": "npm run env:playground:start -- --reset",
    "plugin-zip": "wp-scripts plugin-zip"
  }
}
